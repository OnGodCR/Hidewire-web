# Server-side only. These are set as encrypted secrets in the Cloudflare Pages
# project, never committed, and never exposed to the browser. The site itself
# ships no environment variables at all: the built HTML, CSS, and JS contain no
# keys, because the browser never talks to the database.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to waitlist_signups.
WAITLIST_TABLE=waitlist_signups
